# Copy to .env and fill in. .env is gitignored — never commit real credentials.

PORT=3000

# ---------------------------------------------------------------------------
# GoHighLevel / LeadConnector
# ---------------------------------------------------------------------------
# A Private Integration token (Settings > Private Integrations) or an OAuth
# access token, with the invoices.write, invoices.readonly and
# contacts.write scopes enabled.
GHL_API_TOKEN=
# The sub-account (location) the invoices belong to.
GHL_LOCATION_ID=
# LeadConnector pins behaviour to a dated version. Leave as-is unless upgrading.
GHL_API_VERSION=2021-07-28

# Optional. If sales tax is already set up as a tax record in GoHighLevel, put
# its id here and GoHighLevel will calculate and report the tax itself. Leave
# blank and the tax is added as an ordinary line item instead — the invoice
# total is correct either way.
GHL_TAX_ID=
GHL_TAX_NAME=

# The GoHighLevel user shown as the sender when an invoice is emailed.
GHL_USER_ID=

# false puts created invoices into GoHighLevel's test mode.
GHL_LIVE_MODE=true
# true emails every invoice as soon as it is created.
GHL_AUTO_SEND=false

# ---------------------------------------------------------------------------
# Payment details printed on the invoice
# ---------------------------------------------------------------------------
PAY_ROUTING_NUMBER=
PAY_ACCOUNT_NUMBER=
PAY_ZELLE=
PAY_CARD_LINK=
